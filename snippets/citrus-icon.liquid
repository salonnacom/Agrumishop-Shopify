{%- comment -%}
  Icona illustrata di un agrume (schede della pagina prezzi). Accetta: key (arance | clementine | limoni | mandarini)
{%- endcomment -%}
<span class="cp__icon" aria-hidden="true">
  {%- case key -%}
    {%- when 'arance' -%}
      <svg viewBox="0 0 32 32"><circle cx="16" cy="18" r="11" fill="#f28a17"/><circle cx="12" cy="14" r="3" fill="#fff" opacity=".35"/><path d="M16 7.5c0-2 .6-3.4 1.6-4.4" stroke="#6b4a1f" stroke-width="1.6" fill="none" stroke-linecap="round"/><path d="M17 6c2.5-3 6.5-3.4 9-2.2-1.6 3-5.6 4.4-9 2.2z" fill="#3f9a3a"/></svg>
    {%- when 'clementine' -%}
      <svg viewBox="0 0 32 32"><ellipse cx="16" cy="19" rx="10" ry="8.6" fill="#ff9d1c"/><circle cx="12.5" cy="16" r="2.4" fill="#fff" opacity=".35"/><path d="M15.5 10.6c-3-3.6-7.6-3.6-10-2 2.2 3 6.6 3.8 10 2z" fill="#3f9a3a"/><path d="M16.5 10.6c2.6-3.8 7-4.4 9.6-3-2 3.2-6.2 4.4-9.6 3z" fill="#2f7f2c"/></svg>
    {%- when 'limoni' -%}
      <svg viewBox="0 0 32 32"><path d="M3.5 18.5c1.4-.6 2-1.6 2.6-3C7.8 11 11.6 9 16 9s8.2 2 9.9 6.5c.6 1.4 1.2 2.4 2.6 3-1.4.6-2 1.6-2.6 3C24.2 25.4 20.4 27 16 27s-8.2-1.6-9.9-5.5c-.6-1.4-1.2-2.4-2.6-3z" fill="#f6d21f"/><ellipse cx="12" cy="15" rx="3" ry="1.8" fill="#fff" opacity=".45"/><path d="M16 9c1.5-3.6 5.4-5.4 9-4.6-1 3.6-5 5.6-9 4.6z" fill="#3f9a3a"/></svg>
    {%- else -%}
      <svg viewBox="0 0 32 32"><ellipse cx="16" cy="19.5" rx="11.5" ry="8.5" fill="#e8620f"/><path d="M10 13.5c1 3 1 9 0 12M16 11v17M22 13.5c-1 3-1 9 0 12" stroke="#c9500a" stroke-width="1" fill="none" opacity=".6"/><circle cx="16" cy="11.4" r="1.4" fill="#6b4a1f"/><path d="M16.5 11c1-4 5-6.2 9-5.6-1.2 3.8-5.2 6-9 5.6z" fill="#3f9a3a"/></svg>
  {%- endcase -%}
</span>
