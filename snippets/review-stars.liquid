{% comment %}
  Stelle recensioni con la stessa grafica di Air Reviews, ma disegnate dal tema:
  l'app non deve più renderizzare un widget per ogni card (INP mobile).
  Media e numero li scrive Air Reviews nei metafield del prodotto.
  La forma della stella (#review-star-shape) è definita una volta sola in layout/theme.liquid.

  Accepts:
  - product: {Object} Prodotto
  - layout: {String} 'stars' (card: stelle + "4,7 · 27 recensioni", su mobile "4,7 (27)")
    oppure 'summary' (scheda: box con stelle grandi e "4,8 · 44 recensioni", tutto cliccabile verso l'elenco Air Reviews)

  Usage:
  {% render 'review-stars', product: card_product %}
  {% render 'review-stars', product: product, layout: 'summary' %}
{% endcomment %}
{%- liquid
  assign review_avg = product.metafields.air_reviews_product.review_avg.value | default: product.metafields.reviews.rating.value.rating | default: 0 | plus: 0
  assign review_count = product.metafields.air_reviews_product.review_count.value | default: product.metafields.reviews.rating_count.value | default: 0 | plus: 0
  assign review_avg_label = product.metafields.air_reviews_product.review_avg.value | default: product.metafields.reviews.rating.value.rating
  case request.locale.iso_code
    when 'de'
      assign label_review = 'Bewertung'
      assign label_reviews = 'Bewertungen'
    when 'en'
      assign label_review = 'review'
      assign label_reviews = 'reviews'
    else
      assign label_review = 'recensione'
      assign label_reviews = 'recensioni'
      assign review_avg_label = review_avg_label | replace: '.', ','
  endcase
  if review_count == 1
    assign label_reviews = label_review
  endif
-%}
{%- if review_count > 0 -%}
  {%- capture stars -%}
    <span class="review-stars" role="img" aria-label="{{ review_avg_label }} / 5 · {{ review_count }} {{ label_reviews }}">
      {%- for i in (1..5) -%}
        {%- liquid
          assign fill = review_avg | minus: forloop.index0 | times: 100 | round
          if fill > 100
            assign fill = 100
          elsif fill < 0
            assign fill = 0
          endif
        -%}
        <span class="review-stars__star" aria-hidden="true">
          <svg class="review-stars__icon review-stars__icon--empty" viewBox="0 0 16 16" width="16" height="16" focusable="false"><use href="#review-star-shape"/></svg>
          {%- if fill > 0 -%}
            <span class="review-stars__fill" style="width: {{ fill }}%;">
              <svg class="review-stars__icon" viewBox="0 0 16 16" width="16" height="16" focusable="false"><use href="#review-star-shape"/></svg>
            </span>
          {%- endif -%}
        </span>
      {%- endfor -%}
    </span>
  {%- endcapture -%}

  {%- if layout == 'summary' -%}
    <a href="#recensioni" class="review-summary" data-review-link>
      {{ stars }}
      <span class="review-summary__text">
        <strong>{{ review_avg_label }}</strong> · <strong>{{ review_count }}</strong> {{ label_reviews -}}
      </span>
    </a>
    <script>
      if (!window.reviewLinkBound) {
        window.reviewLinkBound = true;
        document.addEventListener('click', (event) => {
          const link = event.target.closest('[data-review-link]');
          const list = document.querySelector('.AirReviews-Embed-BlockWrapper');
          if (!link || !list) return;
          event.preventDefault();
          list.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    </script>
  {%- else -%}
    <div class="review-stars-row">
      {{ stars }}
      <span class="review-stars-row__text" aria-hidden="true">
        <strong>{{ review_avg_label }}</strong>
        <span class="review-stars-row__long">· <strong>{{ review_count }}</strong> {{ label_reviews }}</span>
        <span class="review-stars-row__short">(<strong>{{ review_count }}</strong>)</span>
      </span>
    </div>
  {%- endif -%}
{%- endif -%}
