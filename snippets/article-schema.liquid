{%- comment -%} JSON-LD BlogPosting per tutti gli articoli (le ricette hanno lo schema Recipe in custom-recipe). Renderizzato da layout/theme.liquid. {%- endcomment -%}
{%- unless article.template_suffix == 'ricetta' -%}
{%- liquid
  assign org_id = shop.url | append: '/#organization'
  assign article_url = request.origin | append: article.url
  if page_description != blank
    assign article_description = page_description | strip
  elsif article.excerpt != blank
    assign article_description = article.excerpt | strip_html | strip
  else
    assign article_description = article.content | strip_html | strip | truncatewords: 40
  endif
  assign article_description = article_description | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&amp;', '&'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": {{ article_url | append: '#article' | json }},
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ article_url | json }} },
    "url": {{ article_url | json }},
    "headline": {{ article.title | json }},
    "description": {{ article_description | json }},
    {%- if article.image %}
    "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "inLanguage": {{ request.locale.iso_code | json }},
    "articleSection": {{ blog.title | json }},
    {%- if article.tags.size > 0 %}
    "keywords": {{ article.tags | join: ', ' | json }},
    {%- endif %}
    "author": {% render 'author-person-schema' %},
    "publisher": { "@id": {{ org_id | json }} },
    "isPartOf": { "@type": "Blog", "name": {{ blog.title | json }}, "url": {{ request.origin | append: blog.url | json }} }
  }
</script>
{%- endunless -%}
