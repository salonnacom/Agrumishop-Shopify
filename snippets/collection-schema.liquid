{%- comment -%} JSON-LD CollectionPage (con ItemList dei prodotti) + BreadcrumbList per le collezioni. Renderizzato da layout/theme.liquid. {%- endcomment -%}
{%- liquid
  assign org_id = shop.url | append: '/#organization'
  assign collection_url = request.origin | append: collection.url
  assign home_url = request.origin | append: routes.root_url
  assign collection_name = collection.metafields.custom.titolo_h1.value | default: collection.title
  if page_description != blank
    assign collection_description = page_description | strip
  else
    assign collection_description = collection.description | strip_html | strip | truncatewords: 40
  endif
  assign collection_description = collection_description | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&amp;', '&'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": {{ collection_url | append: '#webpage' | json }},
        "url": {{ collection_url | json }},
        "name": {{ collection_name | json }},
        {%- if collection_description != blank %}
        "description": {{ collection_description | json }},
        {%- endif %}
        "inLanguage": {{ request.locale.iso_code | json }},
        "isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} },
        "publisher": { "@id": {{ org_id | json }} },
        "breadcrumb": { "@id": {{ collection_url | append: '#breadcrumb' | json }} },
        "mainEntity": {
          "@type": "ItemList",
          "numberOfItems": {{ collection.products_count | at_most: 50 }},
          "itemListElement": [
            {%- for product in collection.products limit: 50 %}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": {{ request.origin | append: product.url | json }},
              "name": {{ product.title | json }}
            }{% unless forloop.last %},{% endunless %}
            {%- endfor %}
          ]
        }
      },
      {
        "@type": "BreadcrumbList",
        "@id": {{ collection_url | append: '#breadcrumb' | json }},
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ home_url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ collection_name | json }}, "item": {{ collection_url | json }} }
        ]
      }
    ]
  }
</script>
