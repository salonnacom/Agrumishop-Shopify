{%- comment -%} Tabella prezzi della collezione (formato, prezzo, prezzo al kg) calcolata dalle varianti "N Kg": resta aggiornata quando cambiano i prezzi. Testi IT/EN in base alla lingua. {%- endcomment -%}
{%- liquid
  assign en = false
  if request.locale.iso_code == 'en'
    assign en = true
  endif
  assign rows = 0
-%}
{%- capture table_rows -%}
  {%- for product in collection.products limit: 50 -%}
    {%- for variant in product.variants -%}
      {%- assign variant_title = variant.title | downcase -%}
      {%- unless variant_title contains 'kg' -%}{%- continue -%}{%- endunless -%}
      {%- assign kg = variant_title | remove: 'kg' | remove: 'box' | remove: 'da ' | strip | replace: ',', '.' | plus: 0 -%}
      {%- if kg <= 0 -%}{%- continue -%}{%- endif -%}
      {%- assign rows = rows | plus: 1 -%}
      {%- assign price_per_kg = variant.price | times: 1.0 | divided_by: kg | round -%}
      <tr>
        <td><a href="{{ variant.url }}">{{ product.title | escape }}</a></td>
        <td>{{ variant.title | escape }}</td>
        <td>{{ variant.price | money }}</td>
        <td>{{ price_per_kg | money }}/kg</td>
        <td>{% if variant.available %}{% if en %}Available{% else %}Disponibile{% endif %}{% else %}{% if en %}Out of season{% else %}Fuori stagione{% endif %}{% endif %}</td>
      </tr>
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if rows > 0 -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: calc({{ section.settings.padding_top }}px * 0.75);
      padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    .collection-prices { max-width: 78rem; margin: 0 auto; }
    .collection-prices .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 2rem 0 1rem; }
    .collection-prices table { width: 100%; border-collapse: collapse; table-layout: auto; font-size: 1.5rem; }
    .collection-prices th, .collection-prices td { border: 1px solid rgba(var(--color-foreground), 0.15); padding: 0.8rem 1rem; text-align: left; vertical-align: middle; white-space: nowrap; }
    .collection-prices td:first-child { white-space: normal; min-width: 18rem; }
    .collection-prices thead th { background: rgba(var(--color-foreground), 0.05); }
  {%- endstyle -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="collection-prices rte">
        <h2>{% if en %}{{ section.settings.heading_en | escape }}{% else %}{{ section.settings.heading | escape }}{% endif %}</h2>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                {%- if en -%}
                  <th>Product</th><th>Box</th><th>Price</th><th>Price per kg</th><th>Availability</th>
                {%- else -%}
                  <th>Prodotto</th><th>Cassetta</th><th>Prezzo</th><th>Prezzo al kg</th><th>Disponibilità</th>
                {%- endif -%}
              </tr>
            </thead>
            <tbody>
              {{ table_rows }}
            </tbody>
          </table>
        </div>
        {%- if en -%}{{ section.settings.note_en }}{%- else -%}{{ section.settings.note }}{%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Prezzi collezione",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo (IT)", "default": "Prezzi" },
    { "type": "text", "id": "heading_en", "label": "Titolo (EN)", "default": "Prices" },
    { "type": "richtext", "id": "note", "label": "Nota sotto la tabella (IT)" },
    { "type": "richtext", "id": "note_en", "label": "Nota sotto la tabella (EN)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ],
  "presets": [{ "name": "Prezzi collezione" }]
}
{% endschema %}
