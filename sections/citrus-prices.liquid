{%- comment -%}
  Prezzi di mercato degli agrumi: media settimanale dei prezzi online (al kg, spedizione inclusa) letta dal metafield shop custom.prezzi_agrumi,
  aggiornato dallo script .claude/prezzi/collect.py. Stile "full" per la pagina dedicata (schede per agrume con riepilogo, grafico della stagione
  ottobre–maggio, tabella dati e schema Dataset), "compact" per la home (riquadri + pulsante verso la pagina).
  Tutti i pannelli restano nell'HTML; lo script mostra solo quello della scheda attiva.
{%- endcomment -%}
{%- liquid
  assign data = shop.metafields.custom.prezzi_agrumi.value
  assign compact = false
  if section.settings.style == 'compact'
    assign compact = true
  endif
  assign active_key = data.citrus.first.key
  for c in data.citrus
    if c.conv.size > 0
      assign active_key = c.key
      break
    endif
  endfor
-%}
{%- if data -%}
  {%- style -%}
    .section-{{ section.id }}-padding { padding-top: calc({{ section.settings.padding_top }}px * 0.75); padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75); }
    @media screen and (min-width: 750px) { .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; } }
    .cp { --cp-line: rgb(var(--color-button)); --cp-muted: rgba(var(--color-foreground), 0.65); --cp-border: rgba(var(--color-foreground), 0.12); }
    .cp__head { max-width: 78rem; margin: 0 auto 2.4rem; text-align: center; }
    .cp__head h2 { margin: 0 0 0.8rem; }
    .cp__head p { margin: 0; color: var(--cp-muted); }
    .cp__grid { display: grid; gap: 1.6rem; grid-template-columns: repeat(2, 1fr); }
    @media screen and (min-width: 750px) { .cp__grid { grid-template-columns: repeat(4, 1fr); } }
    .cp__card { border: 1px solid var(--cp-border); border-radius: 1.6rem; overflow: hidden; display: flex; flex-direction: column; min-width: 0; background: rgb(var(--color-background)); box-shadow: 0 0.2rem 1.2rem rgba(var(--color-foreground), 0.06); transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .cp__card:hover { transform: translateY(-0.3rem); box-shadow: 0 0.8rem 2.4rem rgba(var(--color-foreground), 0.12); }
    .cp__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: linear-gradient(135deg, rgba(var(--color-button), 0.22), rgba(var(--color-button), 0.06)); }
    .cp__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
    .cp__card:hover .cp__media img { transform: scale(1.04); }
    .cp__card--off .cp__media img { filter: grayscale(0.6); opacity: 0.75; }
    .cp__badge { position: absolute; left: 1rem; bottom: 1rem; background: rgb(var(--color-background)); color: rgb(var(--color-foreground)); font-weight: 700; font-size: 1.5rem; padding: 0.4rem 1.2rem; border-radius: 4rem; box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.12); }
    .cp__badge { display: inline-flex; align-items: center; gap: 0.5rem; padding-left: 0.6rem; }
    .cp__badge .cp__icon { width: 2.4rem; height: 2.4rem; background: none; box-shadow: none; }
    .cp__badge .cp__icon svg { width: 2.4rem; height: 2.4rem; }
    .cp__media--blank .cp__badge .cp__icon, .cp__media--blank .cp__badge .cp__icon svg { width: 3rem; height: 3rem; }
    .cp__media--blank .cp__badge { left: 50%; bottom: 50%; transform: translate(-50%, 50%); font-size: 1.8rem; }
    .cp__body { padding: 1.4rem 1.4rem 1.6rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
    .cp--compact .cp__price { color: rgb(var(--color-button)); font-size: 3.2rem; }
    .cp--compact .cp__price small { color: var(--cp-muted); }
    .cp__trend { border-radius: 4rem; padding: 0.1rem 0.8rem; font-size: 1.3rem; }
    .cp__trend--up { background: rgba(179, 38, 30, 0.1); } .cp__trend--down { background: rgba(27, 127, 59, 0.1); } .cp__trend--flat { background: rgba(var(--color-foreground), 0.06); }
    .cp__spark { width: 100%; height: auto; display: block; margin: 0.4rem 0 0; overflow: visible; }
    .cp__spark text { font-size: 10px; fill: var(--cp-muted); }
    .cp__links { margin-top: auto; padding-top: 0.8rem; display: flex; flex-direction: column; gap: 0.3rem; font-size: 1.4rem; }
    .cp__links a { color: rgb(var(--color-foreground)); text-underline-offset: 0.3rem; }
    .cp__links a::after { content: ' →'; }
    .cp__links a { white-space: nowrap; }
    @media screen and (max-width: 749px) {
      .cp--compact .cp__grid { grid-template-columns: 1fr; gap: 1.2rem; }
      .cp--compact .cp__card { flex-direction: row; }
      .cp--compact .cp__media { flex: 0 0 36%; aspect-ratio: auto; min-height: 15rem; }
      .cp--compact .cp__media a { position: absolute; inset: 0; }
      .cp--compact .cp__badge { left: 0.5rem; bottom: 0.6rem; font-size: 1.2rem; padding: 0.2rem 0.8rem 0.2rem 0.4rem; gap: 0.3rem; max-width: calc(100% - 1rem); } .cp--compact .cp__badge .cp__icon, .cp--compact .cp__badge .cp__icon svg { width: 1.8rem; height: 1.8rem; }
      .cp--compact .cp__media--blank .cp__badge { left: 50%; bottom: 50%; }
      .cp--compact .cp__price { font-size: 2.8rem; }
      .cp__body { padding: 1.2rem 1.4rem; gap: 0.3rem; }
      .cp__body .cp__label, .cp__body .cp__meta, .cp__body .cp__wait { font-size: 1.3rem; }
      .cp__spark { max-width: 22rem; }
      .cp__links { flex-direction: row; flex-wrap: wrap; gap: 0.4rem 1.6rem; font-size: 1.3rem; padding-top: 0.6rem; }
    }
    .cp__name { font-size: 1.8rem; margin: 0; }
    .cp__label { font-size: 1.3rem; color: var(--cp-muted); margin: 0; }
    .cp__price { font-size: 2.4rem; font-weight: 700; line-height: 1.1; margin: 0.4rem 0 0; display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; }
    .cp__price small { font-size: 1.4rem; font-weight: 400; color: var(--cp-muted); }
    .cp__trend { font-size: 1.4rem; font-weight: 600; }
    .cp__trend--up { color: #b3261e; } .cp__trend--down { color: #1b7f3b; } .cp__trend--flat { color: var(--cp-muted); }
    .cp__variety { font-size: 1.5rem; margin: 0; }
    .cp__meta, .cp__wait { font-size: 1.4rem; color: var(--cp-muted); margin: 0; }
    .cp__wait { font-style: italic; }
    .cp__foot { text-align: center; margin-top: 2rem; font-size: 1.4rem; color: var(--cp-muted); display: flex; flex-direction: column; align-items: center; gap: 1.6rem; }
    .cp__foot p { margin: 0; }
    .cp__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.8rem; margin-bottom: 2rem; }
    .cp__tab { font: inherit; font-size: 1.5rem; padding: 0.8rem 1.8rem; border-radius: 4rem; border: 1px solid var(--cp-border); background: transparent; color: rgb(var(--color-foreground)); cursor: pointer; }
    .cp__tab { display: inline-flex; align-items: center; gap: 0.8rem; padding-left: 0.8rem; }
    .cp__icon { flex: 0 0 auto; width: 3.6rem; height: 3.6rem; border-radius: 50%; background: #fff; box-shadow: 0 0.1rem 0.4rem rgba(0, 0, 0, 0.15); display: inline-flex; align-items: center; justify-content: center; }
    .cp__icon svg { width: 2.8rem; height: 2.8rem; display: block; }
    .cp__tab[aria-selected="true"] { background: rgb(var(--color-button)); border-color: rgb(var(--color-button)); color: rgb(var(--color-button-text)); }
    .cp__panel { border: 1px solid var(--cp-border); border-radius: 1.2rem; padding: 2rem; display: grid; gap: 2rem; grid-template-columns: 1fr; }
    .cp__panel[hidden] { display: none; }
    @media screen and (min-width: 990px) { .cp__panel { grid-template-columns: minmax(24rem, 1fr) 2.4fr; padding: 2.8rem; } }
    .cp__summary { display: flex; flex-direction: column; gap: 0.8rem; min-width: 0; }
    .cp__panel .cp__name { font-size: 2.2rem; }
    .cp__panel .cp__price { font-size: 4rem; color: rgb(var(--color-button)); }
    .cp__panel .cp__price small { color: var(--cp-muted); }
    @media screen and (max-width: 749px) { .cp__tabs { gap: 0.4rem; flex-wrap: nowrap; } .cp__tab { font-size: 1.3rem; padding: 0.6rem 0.8rem; white-space: nowrap; flex-direction: column; gap: 0.4rem; border-radius: 1.4rem; flex: 1 1 0; min-width: 0; } .cp__icon { width: 3.4rem; height: 3.4rem; } .cp__icon svg { width: 2.6rem; height: 2.6rem; } .cp__panel { padding: 1.6rem; } }
    .cp__plot { min-width: 0; }
    .cp__chart { width: 100%; height: auto; display: block; overflow: visible; }
    .cp__chart text { font-size: 11px; fill: var(--cp-muted); }
    .cp__chart .cp__empty { font-size: 14px; font-style: italic; }
    .cp__apex { margin: 0 -0.8rem 0 -0.4rem; min-height: 24rem; }
    .cp__apex .apexcharts-tooltip { border-radius: 1rem; box-shadow: 0 0.6rem 2rem rgba(0, 0, 0, 0.12); border: 0; }
    .cp__tip { padding: 0.8rem 1.2rem; font-size: 1.3rem; line-height: 1.5; }
    .cp__tip strong { display: block; margin-bottom: 0.2rem; }
    .cp__tip i { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 50%; margin-right: 0.5rem; background: var(--cp-line); }
    .cp__tip i.cp__tip-bio { background: transparent; border: 1.5px solid rgba(var(--color-foreground), 0.55); }
    .cp__legend { display: flex; gap: 1.6rem; font-size: 1.3rem; color: var(--cp-muted); margin: 0.8rem 0 0; flex-wrap: wrap; }
    .cp__legend span::before { content: ''; display: inline-block; width: 1.6rem; height: 0; border-top: 2px solid var(--cp-line); vertical-align: middle; margin-right: 0.5rem; }
    .cp__legend .cp__legend-band::before { height: 0.8rem; border: 0; background: var(--cp-line); opacity: 0.18; }
    .cp__legend .cp__legend-bio::before { border-top-style: dashed; border-color: rgba(var(--color-foreground), 0.55); }
    .cp__data { grid-column: 1 / -1; font-size: 1.4rem; }
    .cp__data table { width: 100%; border-collapse: collapse; margin-top: 0.8rem; }
    .cp__data th, .cp__data td { border-bottom: 1px solid var(--cp-border); padding: 0.4rem 0.6rem; text-align: left; white-space: nowrap; }
    .cp__brief { max-width: 78rem; margin: 0 auto 2.4rem; padding: 1.6rem 2rem; border-left: 0.4rem solid rgb(var(--color-button)); background: rgba(var(--color-button), 0.06); border-radius: 0 1.2rem 1.2rem 0; }
    .cp__brief p, .cp__brief ul { margin: 0; }
    .cp__brief-title { font-weight: 700; }
    .cp__brief ul { padding-left: 2rem; margin: 0.6rem 0; }
    .cp__brief .cp__meta { margin-top: 0.4rem; }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="cp{% if compact %} cp--compact{% endif %}" id="cp-{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          <div class="cp__head">
            <h2 class="h2">{{ section.settings.heading | escape }}</h2>
            <p>{{ 'sections.citrus_prices.subtitle' | t }}</p>
          </div>
        {%- endif -%}

        {%- if compact -%}
          <div class="cp__grid">
            {%- for c in data.citrus -%}
              {%- liquid
                assign name_key = 'sections.citrus_prices.names.' | append: c.key
                assign season_key = 'sections.citrus_prices.season.' | append: c.key
                assign product_key = 'product_' | append: c.key
                assign product = section.settings[product_key]
                assign page_url = section.settings.link | append: '#' | append: c.key
              -%}
              <div class="cp__card{% if c.conv.size == 0 %} cp__card--off{% endif %}">
                <div class="cp__media{% if product.featured_media == blank %} cp__media--blank{% endif %}">
                  {%- if product.featured_media -%}
                    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                      {{- product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 25vw, 50vw', alt: product.title -}}
                    </a>
                  {%- endif -%}
                  <span class="cp__badge">{%- render 'citrus-icon', key: c.key -%}{{ name_key | t }}</span>
                </div>
                <div class="cp__body">
                  {%- if c.conv.size > 0 -%}
                    {%- render 'citrus-prices-summary', c: c -%}
                    <svg class="cp__spark" viewBox="0 0 200 56" aria-hidden="true" data-cp-spark="{{ c.key }}"></svg>
                  {%- else -%}
                    <p class="cp__wait">{{ 'sections.citrus_prices.waiting' | t }}</p>
                    <p class="cp__meta">{{ season_key | t }}</p>
                  {%- endif -%}
                  <div class="cp__links">
                    {%- if section.settings.link != blank -%}<a href="{{ page_url }}">{{ 'sections.citrus_prices.trend_link' | t }}</a>{%- endif -%}
                    {%- if product != blank -%}<a href="{{ product.url }}">{{ 'sections.citrus_prices.product_link' | t }}</a>{%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          {%- comment -%} Riepilogo testuale dell'ultima rilevazione: frase citabile (motori di ricerca e assistenti AI), solo agrumi con media della settimana corrente. {%- endcomment -%}
          {%- liquid
            assign months = 'sections.citrus_prices.months' | t | split: ','
            assign month_index = data.updated | date: '%m' | plus: 0 | minus: 1
            assign updated_year = data.updated | date: '%Y'
            assign updated_day = data.updated | date: '%-d'
            assign updated_day = 'sections.citrus_prices.day' | t: day: updated_day
            assign updated_long = updated_day | append: ' ' | append: months[month_index] | append: ' ' | append: updated_year
            assign waiting_names = ''
          -%}
          <div class="cp__brief">
            <p class="cp__brief-title">{{ 'sections.citrus_prices.brief_title' | t: date: updated_long }}</p>
            <ul>
              {%- for c in data.citrus -%}
                {%- assign name_key = 'sections.citrus_prices.names.' | append: c.key -%}
                {%- if c.conv.last and c.conv.last.d == data.updated -%}
                  {%- liquid
                    assign b_price = c.conv.last.avg | times: 100 | round | money
                    assign b_min = c.conv.last.min | times: 100 | round | money
                    assign b_max = c.conv.last.max | times: 100 | round | money
                    assign b_name = name_key | t
                  -%}
                  <li>
                    {{- 'sections.citrus_prices.brief_line' | t: name: b_name, price: b_price, min: b_min, max: b_max -}}
                    {%- for v in c.varieties -%}
                      {%- if v.conv.last and v.conv.last.d == data.updated -%}
                        {%- assign var_key = 'sections.citrus_prices.varieties.' | append: v.key -%}
                        {%- assign var_price = v.conv.last.avg | times: 100 | round | money -%}
                        ; {{ var_key | t }} {{ var_price }}/kg
                      {%- endif -%}
                    {%- endfor -%}
                  </li>
                {%- else -%}
                  {%- capture waiting_name -%}{{ name_key | t }}{%- endcapture -%}
                  {%- if waiting_names == '' -%}{%- assign waiting_names = waiting_name -%}{%- else -%}{%- assign waiting_names = waiting_names | append: ', ' | append: waiting_name -%}{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if waiting_names != '' -%}<p class="cp__meta">{{ 'sections.citrus_prices.brief_waiting' | t: names: waiting_names }}</p>{%- endif -%}
            <p class="cp__meta">{{ 'sections.citrus_prices.brief_source' | t }}</p>
          </div>

          <div class="cp__tabs" role="tablist" aria-label="{{ 'sections.citrus_prices.tabs_label' | t }}">
            {%- for c in data.citrus -%}
              {%- assign name_key = 'sections.citrus_prices.names.' | append: c.key -%}
              <button type="button" class="cp__tab" role="tab" id="cp-tab-{{ section.id }}-{{ c.key }}" aria-controls="cp-panel-{{ section.id }}-{{ c.key }}" aria-selected="{% if c.key == active_key %}true{% else %}false{% endif %}"{% unless c.key == active_key %} tabindex="-1"{% endunless %}>
                {%- render 'citrus-icon', key: c.key -%}<span>{{ name_key | t }}</span>
              </button>
            {%- endfor -%}
          </div>

          {%- for c in data.citrus -%}
            {%- liquid
              assign name_key = 'sections.citrus_prices.names.' | append: c.key
              assign season_key = 'sections.citrus_prices.season.' | append: c.key
              assign pts = c.conv
              assign bio_last = c.bio.last
            -%}
            <div class="cp__panel" role="tabpanel" id="cp-panel-{{ section.id }}-{{ c.key }}" aria-labelledby="cp-tab-{{ section.id }}-{{ c.key }}"{% unless c.key == active_key %} hidden{% endunless %}>
              <div class="cp__summary">
                <h3 class="cp__name">{{ name_key | t }}</h3>
                {%- if pts.size > 0 -%}
                  {%- render 'citrus-prices-summary', c: c -%}
                  {%- for v in c.varieties -%}
                    {%- if v.conv.last and v.conv.last.d == pts.last.d -%}
                      {%- liquid
                        assign var_key = 'sections.citrus_prices.varieties.' | append: v.key
                        assign var_name = var_key | t
                        assign var_price = v.conv.last.avg | times: 100 | round | money
                        assign var_min = v.conv.last.min | times: 100 | round | money
                        assign var_max = v.conv.last.max | times: 100 | round | money
                      -%}
                      <p class="cp__variety">{{ 'sections.citrus_prices.variety_line' | t: name: var_name, price: var_price, min: var_min, max: var_max }}</p>
                    {%- endif -%}
                  {%- endfor -%}
                  <p class="cp__meta">
                    {%- if bio_last -%}{%- assign bio_s = bio_last.avg | times: 100 | round | money -%}{{ 'sections.citrus_prices.bio_average' | t: price: bio_s }}{%- else -%}{{ 'sections.citrus_prices.bio_missing' | t }}{%- endif -%}
                  </p>
                {%- else -%}
                  <p class="cp__wait">{{ 'sections.citrus_prices.waiting' | t }}</p>
                {%- endif -%}
                <p class="cp__meta">{{ season_key | t }}</p>
                {%- if data.updated -%}{%- assign updated_s = data.updated | date: '%d/%m/%Y' -%}<p class="cp__meta">{{ 'sections.citrus_prices.updated' | t: date: updated_s }}</p>{%- endif -%}
              </div>
              <div class="cp__plot">
                <svg class="cp__chart" viewBox="0 0 640 300" role="img" aria-label="{{ 'sections.citrus_prices.chart_label' | t: name: c.name }}" data-cp-chart="{{ c.key }}" data-cp-empty="{{ 'sections.citrus_prices.waiting' | t | escape }}"></svg>
                <p class="cp__legend"><span>{{ 'sections.citrus_prices.legend_conv' | t }}</span>{% if c.bio.size > 0 %}<span class="cp__legend-bio">{{ 'sections.citrus_prices.legend_bio' | t }}</span>{% endif %}</p>
              </div>
              {%- if pts.size > 0 -%}
                <details class="cp__data">
                  <summary>{{ 'sections.citrus_prices.show_data' | t }}</summary>
                  <table>
                    <thead><tr><th>{{ 'sections.citrus_prices.col_week' | t }}</th><th>{{ 'sections.citrus_prices.col_avg' | t }}</th><th>{{ 'sections.citrus_prices.col_range' | t }}</th>{% for v in c.varieties %}{% assign var_key = 'sections.citrus_prices.varieties.' | append: v.key %}<th>{{ var_key | t }} €/kg</th>{% endfor %}<th>{{ 'sections.citrus_prices.col_bio' | t }}</th></tr></thead>
                    <tbody>
                      {%- for p in pts reversed -%}
                        {%- assign bio_avg = '' -%}
                        {%- for b in c.bio -%}{%- if b.d == p.d -%}{%- assign bio_avg = b.avg -%}{%- endif -%}{%- endfor -%}
                        <tr>
                          <td>{{ p.d | date: '%d/%m/%Y' }}</td>
                          <td>{{ p.avg | times: 100 | round | money }}</td>
                          <td>{{ p.min | times: 100 | round | money }} – {{ p.max | times: 100 | round | money }}</td>
                          {%- for v in c.varieties -%}
                            {%- assign var_avg = '' -%}
                            {%- for vp in v.conv -%}{%- if vp.d == p.d -%}{%- assign var_avg = vp.avg -%}{%- endif -%}{%- endfor -%}
                            <td>{% if var_avg != '' %}{{ var_avg | times: 100 | round | money }}{% else %}–{% endif %}</td>
                          {%- endfor -%}
                          <td>{% if bio_avg != '' %}{{ bio_avg | times: 100 | round | money }}{% else %}–{% endif %}</td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                </details>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- if compact -%}
          <div class="cp__foot">
            {%- if data.updated -%}{%- assign updated_s = data.updated | date: '%d/%m/%Y' -%}<p>{{ 'sections.citrus_prices.updated' | t: date: updated_s }}</p>{%- endif -%}
            {%- if section.settings.link != blank -%}
              <a href="{{ section.settings.link }}" class="button button--primary">{{ 'sections.citrus_prices.cta' | t }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" id="cp-data-{{ section.id }}">{{ data | json }}</script>
    <script>
      (function () {
        var root = document.getElementById('cp-{{ section.id }}');
        var raw = document.getElementById('cp-data-{{ section.id }}');
        if (!root || !raw) return;
        var data = JSON.parse(raw.textContent), NS = 'http://www.w3.org/2000/svg';

        var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
        function select(tab, focus) {
          tabs.forEach(function (t) {
            var on = t === tab;
            t.setAttribute('aria-selected', on);
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
          });
          if (focus) tab.focus();
          upgrade();
        }
        var fromHash = tabs.filter(function (t) { return location.hash && t.id === 'cp-tab-{{ section.id }}-' + location.hash.slice(1); })[0];
        if (fromHash) { select(fromHash); root.scrollIntoView(); }
        tabs.forEach(function (t, i) {
          t.addEventListener('click', function () { select(t); });
          t.addEventListener('keydown', function (e) {
            var j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
            if (j === null) return;
            e.preventDefault();
            select(tabs[(j + tabs.length) % tabs.length], true);
          });
        });

        // Grafico della stagione ottobre–maggio: asse X a mesi, fascia min–max, media con punti, bio tratteggiato.
        var lang = document.documentElement.lang || 'it';
        function el(tag, attrs, parent) { var e = document.createElementNS(NS, tag); for (var k in attrs) e.setAttribute(k, attrs[k]); parent.appendChild(e); return e; }
        function t(d) { var p = d.split('-'); return Date.UTC(+p[0], +p[1] - 1, +p[2]); }
        function num(v) { return v.toLocaleString(lang, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function day(d) { var p = d.split('-'); return p[2] + '/' + p[1]; }
        var ref = (data.updated || new Date().toISOString().slice(0, 10)).split('-');
        var y0 = +ref[1] >= 8 ? +ref[0] : +ref[0] - 1;
        var start = Date.UTC(y0, 9, 1), end = Date.UTC(y0 + 1, 5, 1);
        var monthFmt = new Intl.DateTimeFormat(lang, { month: 'short', timeZone: 'UTC' });

        // Mini grafico (home): stessa stagione, senza assi, solo fascia, linea e ultimo punto evidenziato.
        data.citrus.forEach(function (c) {
          var svg = root.querySelector('[data-cp-spark="' + c.key + '"]');
          if (!svg) return;
          var pts = c.conv.filter(function (p) { var v = t(p.d); return v >= start && v < end; });
          if (!pts.length) return;
          var W = 200, H = 56, T = 6, B = 16, P = 4;
          var x = function (d) { return P + (W - 2 * P) * (t(d) - start) / (end - start); };
          var lo = Math.min.apply(null, pts.map(function (p) { return p.min; })), hi = Math.max.apply(null, pts.map(function (p) { return p.max; }));
          var pad = Math.max((hi - lo) * 0.2, 0.25); lo -= pad; hi += pad;
          var y = function (v) { return T + (H - T - B) * (1 - (v - lo) / (hi - lo)); };
          var fg = (getComputedStyle(svg).getPropertyValue('--cp-line') || '').trim() || '#c25e00';
          el('line', { x1: P, x2: W - P, y1: H - B, y2: H - B, stroke: 'currentColor', 'stroke-opacity': 0.15 }, svg);
          el('text', { x: P, y: H - 3, 'text-anchor': 'start' }, svg).textContent = monthFmt.format(new Date(start)).replace('.', '');
          el('text', { x: W - P, y: H - 3, 'text-anchor': 'end' }, svg).textContent = monthFmt.format(new Date(Date.UTC(y0 + 1, 4, 1))).replace('.', '');
          if (pts.length > 1) {
            var band = pts.map(function (p) { return x(p.d) + ',' + y(p.max); }).concat(pts.slice().reverse().map(function (p) { return x(p.d) + ',' + y(p.min); }));
            el('polygon', { points: band.join(' '), fill: fg, 'fill-opacity': 0.15 }, svg);
            el('polyline', { points: pts.map(function (p) { return x(p.d) + ',' + y(p.avg); }).join(' '), fill: 'none', stroke: fg, 'stroke-width': 2.2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }, svg);
          } else {
            el('line', { x1: x(pts[0].d), x2: x(pts[0].d), y1: y(pts[0].min), y2: y(pts[0].max), stroke: fg, 'stroke-opacity': 0.3, 'stroke-width': 6, 'stroke-linecap': 'round' }, svg);
          }
          var last = pts[pts.length - 1];
          el('circle', { cx: x(last.d), cy: y(last.avg), r: 6, fill: fg, 'fill-opacity': 0.2 }, svg);
          el('circle', { cx: x(last.d), cy: y(last.avg), r: 3.5, fill: fg }, svg);
        });

        data.citrus.forEach(function (c) {
          var svg = root.querySelector('[data-cp-chart="' + c.key + '"]');
          if (!svg) return;
          var inSeason = function (p) { var v = t(p.d); return v >= start && v < end; };
          var conv = c.conv.filter(inSeason), bio = c.bio.filter(inSeason);
          // Larghezza del viewBox pari a quella reale (min 320, max 640): le etichette restano leggibili anche su telefono.
          var W = Math.round(Math.max(320, Math.min(640, root.clientWidth - 40))), H = W < 480 ? 240 : 300, L = 48, R = 12, T = 14, B = 30;
          svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
          var x = function (d) { return L + (W - L - R) * (t(d) - start) / (end - start); };

          var vals = [];
          conv.forEach(function (p) { vals.push(p.min, p.max); });
          bio.forEach(function (p) { vals.push(p.avg); });
          var lo = 0, hi = 4, step = 1;
          if (vals.length) {
            lo = Math.min.apply(null, vals); hi = Math.max.apply(null, vals);
            var pad = Math.max((hi - lo) * 0.2, 0.3);
            lo = Math.max(0, lo - pad); hi = hi + pad;
            step = [0.25, 0.5, 1, 2, 5].filter(function (s) { return (hi - lo) / s <= 5; })[0] || 5;
            lo = Math.floor(lo / step) * step; hi = Math.ceil(hi / step) * step;
          }
          var y = function (v) { return T + (H - T - B) * (1 - (v - lo) / (hi - lo)); };

          for (var i = 0; i <= Math.round((hi - lo) / step); i++) {
            var v = lo + step * i;
            el('line', { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: 'currentColor', 'stroke-opacity': i === 0 ? 0.25 : 0.1 }, svg);
            el('text', { x: L - 8, y: y(v) + 4, 'text-anchor': 'end' }, svg).textContent = num(v) + ' €';
          }
          for (var m = 0; m < 8; m++) {
            var ms = Date.UTC(y0, 9 + m, 1), me = Date.UTC(y0, 10 + m, 1);
            var mx = L + (W - L - R) * (ms - start) / (end - start);
            if (m > 0) el('line', { x1: mx, x2: mx, y1: T, y2: H - B, stroke: 'currentColor', 'stroke-opacity': 0.06 }, svg);
            el('text', { x: L + (W - L - R) * ((ms + me) / 2 - start) / (end - start), y: H - 8, 'text-anchor': 'middle' }, svg).textContent = monthFmt.format(new Date(ms)).replace('.', '');
          }

          if (!conv.length && !bio.length) {
            el('text', { x: L + (W - L - R) / 2, y: T + (H - T - B) / 2, 'text-anchor': 'middle', 'class': 'cp__empty' }, svg).textContent = svg.getAttribute('data-cp-empty');
            return;
          }
          var fg = (getComputedStyle(svg).getPropertyValue('--cp-line') || '').trim() || '#c25e00';
          if (conv.length > 1) {
            var band = conv.map(function (p) { return x(p.d) + ',' + y(p.max); }).concat(conv.slice().reverse().map(function (p) { return x(p.d) + ',' + y(p.min); }));
            el('polygon', { points: band.join(' '), fill: fg, 'fill-opacity': 0.14 }, svg);
            el('polyline', { points: conv.map(function (p) { return x(p.d) + ',' + y(p.avg); }).join(' '), fill: 'none', stroke: fg, 'stroke-width': 2.5, 'stroke-linejoin': 'round' }, svg);
          } else if (conv.length === 1) {
            el('line', { x1: x(conv[0].d), x2: x(conv[0].d), y1: y(conv[0].min), y2: y(conv[0].max), stroke: fg, 'stroke-opacity': 0.35, 'stroke-width': 8, 'stroke-linecap': 'round' }, svg);
          }
          if (bio.length > 1) el('polyline', { points: bio.map(function (p) { return x(p.d) + ',' + y(p.avg); }).join(' '), fill: 'none', stroke: 'currentColor', 'stroke-opacity': 0.55, 'stroke-width': 1.8, 'stroke-dasharray': '5 4' }, svg);
          bio.forEach(function (p) {
            var dot = el('circle', { cx: x(p.d), cy: y(p.avg), r: 3.5, fill: 'none', stroke: 'currentColor', 'stroke-opacity': 0.6, 'stroke-width': 1.5 }, svg);
            el('title', {}, dot).textContent = day(p.d) + ' bio: ' + num(p.avg) + ' €/kg';
          });
          conv.forEach(function (p) {
            var dot = el('circle', { cx: x(p.d), cy: y(p.avg), r: 4.5, fill: fg }, svg);
            el('title', {}, dot).textContent = day(p.d) + ': ' + num(p.avg) + ' €/kg (' + num(p.min) + '–' + num(p.max) + ')';
          });
        });

        // Grafico interattivo (ApexCharts) solo sulla pagina: libreria caricata in differita, disegnato quando la scheda è visibile.
        // Se la libreria non arriva resta l'SVG qui sopra.
        function upgrade() {
          if (!window.ApexCharts) return;
          root.querySelectorAll('[data-cp-chart]').forEach(function (svg) {
            if (svg.hasAttribute('data-cp-apex') || !svg.getClientRects().length) return;
            var c = data.citrus.filter(function (x) { return x.key === svg.getAttribute('data-cp-chart'); })[0];
            if (!c) return;
            svg.setAttribute('data-cp-apex', '');
            var inSeason = function (p) { var v = t(p.d); return v >= start && v < end; };
            var conv = c.conv.filter(inSeason), bio = c.bio.filter(inSeason);
            var cs = getComputedStyle(svg), fg = (cs.getPropertyValue('--cp-line') || '').trim() || '#c25e00';
            var muted = (cs.getPropertyValue('--cp-muted') || '').trim() || '#777';
            var ink = cs.color, bioColor = ink.replace('rgb(', 'rgba(').replace(')', ', 0.55)');
            var vals = [];
            conv.forEach(function (p) { vals.push(p.min, p.max); });
            bio.forEach(function (p) { vals.push(p.avg); });
            var lo = 0, hi = 4, step = 1;
            if (vals.length) {
              lo = Math.min.apply(null, vals); hi = Math.max.apply(null, vals);
              var pad = Math.max((hi - lo) * 0.2, 0.3);
              lo = Math.max(0, lo - pad); hi = hi + pad;
              step = [0.25, 0.5, 1, 2, 5].filter(function (s) { return (hi - lo) / s <= 5; })[0] || 5;
              lo = Math.floor(lo / step) * step; hi = Math.ceil(hi / step) * step;
            }
            var series = [
              { name: 'min–max', type: 'rangeArea', data: conv.map(function (p) { return { x: t(p.d), y: [p.min, p.max] }; }) },
              { name: 'media', type: 'line', data: conv.map(function (p) { return { x: t(p.d), y: p.avg }; }) }
            ];
            if (bio.length) series.push({ name: 'bio', type: 'line', data: bio.map(function (p) { return { x: t(p.d), y: p.avg }; }) });
            var box = document.createElement('div');
            box.className = 'cp__apex';
            svg.parentNode.insertBefore(box, svg);
            svg.hidden = true;
            new ApexCharts(box, {
              chart: { type: 'rangeArea', height: root.clientWidth < 520 ? 260 : 320, fontFamily: getComputedStyle(root).fontFamily, foreColor: muted,
                toolbar: { show: false }, zoom: { enabled: false }, animations: { enabled: true, easing: 'easeout', speed: 700 } },
              series: series,
              colors: [fg, fg, bioColor],
              fill: { type: ['gradient', 'solid', 'solid'], opacity: [0.22, 1, 1], gradient: { shadeIntensity: 0, opacityFrom: 0.28, opacityTo: 0.08, stops: [0, 100] } },
              stroke: { curve: 'smooth', width: [0, 3, 2], dashArray: [0, 0, 5] },
              markers: { size: [0, conv.length > 1 ? 4 : 7, 4], strokeWidth: 2, strokeColors: cs.backgroundColor === 'rgba(0, 0, 0, 0)' ? '#fff' : cs.backgroundColor, hover: { sizeOffset: 2 } },
              dataLabels: { enabled: false },
              legend: { show: false },
              noData: { text: svg.getAttribute('data-cp-empty'), style: { color: muted, fontSize: '14px' } },
              grid: { borderColor: ink.replace('rgb(', 'rgba(').replace(')', ', 0.1)'), strokeDashArray: 4, padding: { left: 8, right: 12 } },
              xaxis: { type: 'datetime', min: start, max: end - 864e5, tickAmount: 8,
                labels: { formatter: function (v) { return monthFmt.format(new Date(v)).replace('.', ''); }, hideOverlappingLabels: true },
                axisBorder: { show: false }, axisTicks: { show: false }, tooltip: { enabled: false },
                crosshairs: { stroke: { color: fg, dashArray: 3 } } },
              yaxis: { min: lo, max: hi, tickAmount: Math.round((hi - lo) / step), labels: { formatter: function (v) { return num(v) + ' €'; } } },
              tooltip: { shared: true, intersect: false, custom: function (o) {
                var x = o.w.globals.seriesX[o.seriesIndex][o.dataPointIndex];
                var p = conv.filter(function (q) { return t(q.d) === x; })[0], b = bio.filter(function (q) { return t(q.d) === x; })[0];
                var d = (p || b).d.split('-'), html = '<div class="cp__tip"><strong>' + d[2] + '/' + d[1] + '/' + d[0] + '</strong>';
                if (p) html += '<i></i>' + num(p.avg) + ' €/kg <span style="color:' + muted + '">(' + num(p.min) + '–' + num(p.max) + ')</span><br>';
                if (b) html += '<i class="cp__tip-bio"></i>bio ' + num(b.avg) + ' €/kg';
                return html + '</div>';
              } }
            }).render();
          });
        }
        if (root.querySelector('[data-cp-chart]')) {
          var lib = document.createElement('script');
          lib.src = 'https://cdnjs.cloudflare.com/ajax/libs/apexcharts/3.54.1/apexcharts.min.js';
          lib.async = true;
          lib.onload = upgrade;
          document.head.appendChild(lib);
        }
      })();
    </script>
  {%- unless compact -%}
    {%- liquid
      assign first_week = ''
      for c in data.citrus
        for p in c.conv
          if first_week == '' or p.d < first_week
            assign first_week = p.d
          endif
        endfor
      endfor
    -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Dataset",
        "name": {{ section.settings.heading | default: page.title | json }},
        "description": {{ 'sections.citrus_prices.dataset_description' | t | json }},
        "url": {{ request.origin | append: request.path | json }},
        "creator": { "@id": {{ shop.url | append: '/#organization' | json }} },
        "isAccessibleForFree": true,
        "license": "https://creativecommons.org/licenses/by/4.0/",
        {%- if first_week != '' -%}"temporalCoverage": {{ first_week | append: '/' | append: data.updated | json }},{%- endif -%}
        "dateModified": {{ data.updated | json }},
        "spatialCoverage": { "@type": "Place", "name": "Italia" },
        "variableMeasured": [
          {%- for c in data.citrus -%}
            {%- assign name_key = 'sections.citrus_prices.names.' | append: c.key -%}
            {%- unless forloop.first %},{% endunless -%}
            { "@type": "PropertyValue", "name": {{ name_key | t | append: ' – €/kg' | json }}, "unitText": "EUR/kg"{% if c.conv.last %}, "value": {{ c.conv.last.avg }}{% endif %} }
            {%- for v in c.varieties -%}
              {%- assign var_key = 'sections.citrus_prices.varieties.' | append: v.key -%}
              {%- assign var_name = var_key | t -%}
              ,{ "@type": "PropertyValue", "name": {{ name_key | t | append: ' ' | append: var_name | append: ' – €/kg' | json }}, "unitText": "EUR/kg"{% if v.conv.last %}, "value": {{ v.conv.last.avg }}{% endif %} }
            {%- endfor -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Prezzi agrumi",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "style", "label": "Stile", "options": [{ "value": "full", "label": "Pagina completa" }, { "value": "compact", "label": "Riquadro compatto" }], "default": "full" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Prezzo degli agrumi oggi" },
    { "type": "url", "id": "link", "label": "Link alla pagina (stile compatto)" },
    { "type": "header", "content": "Prodotti nei riquadri (stile compatto)" },
    { "type": "product", "id": "product_arance", "label": "Arance" },
    { "type": "product", "id": "product_clementine", "label": "Clementine" },
    { "type": "product", "id": "product_limoni", "label": "Limoni" },
    { "type": "product", "id": "product_mandarini", "label": "Mandarini" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ],
  "presets": [{ "name": "Prezzi agrumi" }]
}
{% endschema %}
