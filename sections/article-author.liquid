{%- comment -%} Firma dell'autore (sotto il titolo) o box autore (in fondo) per gli articoli del blog. Testi in locales: blogs.author.* {%- endcomment -%}
{%- assign author_page = pages['pietro-salonna'] -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .article-author { max-width: 78rem; margin: 0 auto; }
  .article-author__byline { margin: 0; font-size: 1.5rem; color: rgba(var(--color-foreground), 0.75); }
  .article-author__byline a { color: rgb(var(--color-foreground)); }
  .article-author__box { border-top: 1px solid rgba(var(--color-foreground), 0.15); padding-top: 2.4rem; }
  .article-author__box h2 { margin: 0 0 0.4rem; font-size: 1.4rem; letter-spacing: 0.06rem; text-transform: uppercase; color: rgba(var(--color-foreground), 0.75); }
  .article-author__name { margin: 0 0 0.8rem; font-size: 2rem; }
  .article-author__name span { font-size: 1.5rem; font-weight: normal; color: rgba(var(--color-foreground), 0.75); }
  .article-author__bio { margin: 0 0 1rem; }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="article-author">
      {%- if section.settings.style == 'byline' -%}
        <p class="article-author__byline">
          {{ 'blogs.author.by' | t | capitalize }}
          {% if author_page != empty %}<a href="{{ author_page.url }}" rel="author">{{ 'blogs.author.name' | t }}</a>{% else %}{{ 'blogs.author.name' | t }}{% endif %},
          {{ 'blogs.author.role' | t | downcase }} · {{ 'blogs.author.company' | t }}
          {%- if article.updated_at %} · {{ 'blogs.author.updated' | t }} {{ article.updated_at | time_tag: format: 'date' }}{% endif %}
        </p>
      {%- else -%}
        <div class="article-author__box">
          <h2>{% if article.template_suffix == 'ricetta' %}{{ 'blogs.author.box_heading_recipe' | t }}{% else %}{{ 'blogs.author.box_heading' | t }}{% endif %}</h2>
          <p class="article-author__name">{{ 'blogs.author.name' | t }} <span>· {{ 'blogs.author.role' | t }}</span></p>
          <p class="article-author__bio">{{ 'blogs.author.bio' | t }}</p>
          {%- if author_page != empty -%}
            <a href="{{ author_page.url }}" rel="author" class="link">{{ 'blogs.author.more' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Autore articolo",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "style", "label": "Stile", "options": [{ "value": "byline", "label": "Firma sotto il titolo" }, { "value": "box", "label": "Box autore" }], "default": "byline" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 24 }
  ],
  "presets": [{ "name": "Autore articolo" }]
}
{% endschema %}
