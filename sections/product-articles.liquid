{%- comment -%}
  Guide e ricette collegate al prodotto: articoli dei blog "news" e "ricette"
  il cui metafield custom.prodotti contiene il prodotto corrente. Un gruppo senza articoli non viene mostrato.
{%- endcomment -%}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .product-articles__group + .product-articles__group {
    margin-top: 4rem;
  }
{%- endstyle -%}

{%- liquid
  assign groups = 'news,ricette' | split: ','
  assign limit = section.settings.post_limit
  assign has_any = false
  for blog_handle in groups
    for a in blogs[blog_handle].articles
      for p in a.metafields.custom.prodotti.value
        if p.id == product.id
          assign has_any = true
          break
        endif
      endfor
      if has_any
        break
      endif
    endfor
    if has_any
      break
    endif
  endfor
-%}

{%- if has_any -%}
  <div class="blog color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width-desktop isolate section-{{ section.id }}-padding">
      {%- for blog_handle in groups -%}
        {%- assign current_blog = blogs[blog_handle] -%}
        {%- assign count = 0 -%}
        {%- for a in current_blog.articles -%}
          {%- for p in a.metafields.custom.prodotti.value -%}
            {%- if p.id == product.id -%}
              {%- assign count = count | plus: 1 -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}

        {%- if count > 0 -%}
          {%- if blog_handle == 'news' -%}
            {%- assign group_heading = section.settings.heading_guides -%}
          {%- else -%}
            {%- assign group_heading = section.settings.heading_recipes -%}
          {%- endif -%}
          {%- assign shown = count -%}
          {%- if shown > limit -%}{%- assign shown = limit -%}{%- endif -%}
          <div class="product-articles__group">
            <div class="title-wrapper-with-link{% if shown > 2 %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
              <h2 class="blog__title {{ section.settings.heading_size }}">{{ group_heading | escape }}</h2>
              {%- if count > limit -%}
                <a href="{{ current_blog.url }}" class="link underlined-link">{{ 'sections.featured_blog.view_all' | t }}</a>
              {%- endif -%}
            </div>

            <slider-component class="slider-mobile-gutter">
              <ul
                id="Slider-{{ section.id }}-{{ blog_handle }}"
                class="blog__posts articles-wrapper contains-card contains-card--article{% if settings.blog_card_style == 'standard' %} contains-card--standard{% endif %} grid grid--peek grid--2-col-tablet grid--3-col-desktop slider {% if shown > 2 %}slider--tablet{% else %}slider--mobile{% endif %}"
                role="list"
              >
                {%- assign rendered = 0 -%}
                {%- for a in current_blog.articles -%}
                  {%- assign match = false -%}
                  {%- for p in a.metafields.custom.prodotti.value -%}
                    {%- if p.id == product.id -%}
                      {%- assign match = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if match -%}
                    {%- assign rendered = rendered | plus: 1 -%}
                    <li
                      id="Slide-{{ section.id }}-{{ blog_handle }}-{{ rendered }}"
                      class="blog__post grid__item article slider__slide slider__slide--full-width"
                    >
                      {% render 'article-card',
                        blog: current_blog,
                        article: a,
                        media_aspect_ratio: 1.66,
                        show_image: true,
                        show_date: false,
                        show_author: false,
                        show_excerpt: true
                      %}
                    </li>
                    {%- if rendered >= limit -%}{%- break -%}{%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </slider-component>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Guide e ricette",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading_guides", "label": "Titolo guide", "default": "Guide e approfondimenti" },
    { "type": "text", "id": "heading_recipes", "label": "Titolo ricette", "default": "Ricette da provare" },
    { "type": "select", "id": "heading_size", "label": "t:sections.all.heading_size.label", "options": [{ "value": "h2", "label": "t:sections.all.heading_size.options__1.label" }, { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" }], "default": "h2" },
    { "type": "range", "id": "post_limit", "min": 1, "max": 3, "step": 1, "label": "Articoli per gruppo", "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ],
  "presets": [{ "name": "Guide e ricette" }]
}
{% endschema %}
