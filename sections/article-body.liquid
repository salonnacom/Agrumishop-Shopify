{%- comment -%} Corpo HTML dell'articolo (article.content) per i template blog-cta che non usano main-article: serve per tabelle e contenuti strutturati. {%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .article-body .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 2rem 0; }
  .article-body table { width: 100%; border-collapse: collapse; table-layout: auto; font-size: 1.5rem; }
  .article-body th, .article-body td { border: 1px solid rgba(var(--color-foreground), 0.15); padding: 0.8rem 1rem; text-align: left; vertical-align: top; }
  .article-body td { text-align: center; }
  .article-body td:nth-child(2) { text-align: left; white-space: nowrap; }
  .article-body thead th { background: rgba(var(--color-foreground), 0.05); }
  .article-body caption { caption-side: bottom; text-align: left; padding-top: 0.8rem; font-size: 1.3rem; color: rgba(var(--color-foreground), 0.75); }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="article-body rte">
      {{ article.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Corpo articolo",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 24 }
  ],
  "presets": [{ "name": "Corpo articolo" }]
}
{% endschema %}
